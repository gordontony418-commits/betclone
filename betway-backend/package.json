{
  "name": "betway-backend",
  "version": "1.0.0",
  "description": "Betway Nigeria backend — Prisma ORM, Express, SQLite",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "vitest run",
    "migrate": "prisma migrate dev --name init",
    "seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "http-proxy-middleware": "3.0.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "fast-check": "3.23.1",
    "prisma": "5.22.0",
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
